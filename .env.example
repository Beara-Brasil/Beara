# URL pública do site (usada em metadados, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://beara.com.br

# Formulário de contato (envio por e-mail via Resend). Só no servidor:
# nunca use NEXT_PUBLIC_ nessas. Sem RESEND_API_KEY o formulário oferece abrir o e-mail da pessoa.
RESEND_API_KEY=
# Quem recebe as mensagens (padrão: contato@beara.com.br)
CONTATO_PARA=contato@beara.com.br
# Remetente. Até verificar o domínio no Resend, use o de teste dele, que só
# entrega para o e-mail dono da conta Resend.
CONTATO_DE=Site Beara <onboarding@resend.dev>
